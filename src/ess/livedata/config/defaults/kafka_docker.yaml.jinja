{# `string` makes StrictUndefined fail before `tojson` attempts serialization. #}
{% set security_protocol = KAFKA_SECURITY_PROTOCOL | trim | upper %}
bootstrap.servers: {{ KAFKA_BOOTSTRAP_SERVERS | string | tojson }}
security.protocol: {{ security_protocol | tojson }}
{% if security_protocol in ['SSL', 'SASL_SSL'] %}
ssl.ca.location: {{ KAFKA_SSL_CA_LOCATION | string | tojson }}
{% endif %}
{% if security_protocol in ['SASL_PLAINTEXT', 'SASL_SSL'] %}
sasl.mechanism: {{ KAFKA_SASL_MECHANISM | string | tojson }}
sasl.username: {{ KAFKA_SASL_USERNAME | string | tojson }}
sasl.password: {{ KAFKA_SASL_PASSWORD | string | tojson }}
{% endif %}
# Max size of a single message, in bytes (~96 MiB): TBL ORCA frames are 33.6 MB.
message.max.bytes: 100971520
# Producer send-queue memory cap, in KILOBYTES (1 GiB), matching librdkafka's
# default. This is what makes the BufferError backpressure valve in
# kafka/sink.py reachable: without a cap the producer queue grows until the
# OOM killer intervenes instead.
queue.buffering.max.kbytes: 1048576
